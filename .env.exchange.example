# Environment variables for API Exchange providers

# Companies House API
COMPANIES_HOUSE_KEY=your_companies_house_key_here

# DVLA API
DVLA_KEY=your_dvla_key_here

# Vehicle Score API
VEHICLE_SCORE_API=https://api.vehiclescore.com
VEHICLE_SCORE_KEY=your_vehicle_score_key_here

# MyCarCheck API
MY_CAR_CHECK_API=https://api.mycarcheck.com
MY_CAR_CHECK_KEY=your_mycarcheck_key_here

# Gov ID Verify
GOV_ID_KEY=your_gov_id_key_here

# Valuation API
VALUATION_API=https://api.valuation.com
VALUATION_KEY=your_valuation_key_here

# Tender API
TENDER_API=https://api.tender.com
